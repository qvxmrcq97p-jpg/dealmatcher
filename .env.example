# Copy to .env.cheaphomesfla (or .env locally) and fill in real values.
# In production these are set as Railway environment variables — NEVER
# committed to git.
#
# Used by:  cheaphomesfla_scraper.py, jb/email_campaign.py, jb/sms_campaign.py,
#           tools/system_watchdog.py, tools/*.py

# ── Salesforce (info@johnsonbuys.com user) ───────────────────────────
SF_USERNAME=info@johnsonbuys.com
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_DOMAIN=johnsonshomes2.my

# ── SendGrid (transactional + drip emails) ──────────────────────────
SENDGRID_API_KEY=

# ── Twilio (outbound SMS + inbound webhook) ─────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Microsoft Graph (cheaphomesfla mailbox scrape) ──────────────────
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_USER_PRINCIPAL=info@cheaphomesfla.com

# ── Green API (cheaphomesfla WhatsApp scrape) ───────────────────────
GREENAPI_INSTANCE_ID=
GREENAPI_TOKEN=

# ── Misc ────────────────────────────────────────────────────────────
EMAIL_ADDRESS=info@johnsonbuys.com
ALERT_TO=info@johnsonbuys.com
FROM_NAME=Chris Johnson

# ── Cloud-mode flag ─────────────────────────────────────────────────
# Set CLOUD_MODE=true on Railway to suppress local-disk log writes.
# Leave unset on Mac for local dev (logs still write to ~/Desktop).
# CLOUD_MODE=true
